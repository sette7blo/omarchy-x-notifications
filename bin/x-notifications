#!/usr/bin/env bash
# Emit Waybar-style JSON with the unread X.com notification count. The
# bundled extension prefixes the webapp window title with "(N) ".

set -u
source "$(dirname -- "${BASH_SOURCE[0]}")/_common.sh"

raw=$(hyprctl clients -j 2>/dev/null | \
  jq -r --arg re "$CLASS_RE" \
    'first(.[] | select(.class | test($re)) | .title) // ""' | \
  grep -oP '^\(\K\d+\+?')

badges=('❶' '❷' '❸' '❹' '❺' '❻' '❼' '❽' '❾' '❿'
        '⓫' '⓬' '⓭' '⓮' '⓯' '⓰' '⓱' '⓲' '⓳' '⓴')

num="${raw%+}"
if [[ -z $raw || ${num:-0} -eq 0 ]]; then
  printf '{"text":"𝕏","tooltip":"X notifications"}\n'
  exit 0
fi

if [[ $raw == *+ || $num -gt 20 ]]; then
  badge='⓴⁺'
else
  badge="${badges[$num - 1]}"
fi

printf '{"text":"𝕏%s","tooltip":"%s unread X notifications"}\n' "$badge" "$raw"
