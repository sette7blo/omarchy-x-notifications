#!/usr/bin/env bash
# Toggle the hidden X popover, launching the webapp first if it isn't running.

set -u
source "$(dirname -- "${BASH_SOURCE[0]}")/_common.sh"

running() {
  hyprctl clients -j 2>/dev/null | \
    jq -e --arg re "$CLASS_RE" '.[] | select(.class | test($re))' >/dev/null
}

if ! running; then
  omarchy-launch-webapp "$URL" \
    --disable-background-timer-throttling \
    --disable-renderer-backgrounding \
    --disable-backgrounding-occluded-windows \
    --load-extension="$EXTENSION_DIR" &
  for _ in {1..25}; do sleep 0.2; running && break; done
fi

hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$WORKSPACE\")"
