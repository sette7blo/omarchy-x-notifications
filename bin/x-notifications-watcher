#!/usr/bin/env bash
# Hide the X popover when focus moves off it. Runs as a user systemd service.

set -u
source "$(dirname -- "${BASH_SOURCE[0]}")/_common.sh"

SOCKET="${XDG_RUNTIME_DIR}/hypr/${HYPRLAND_INSTANCE_SIGNATURE}/.socket2.sock"
[[ -S $SOCKET ]] || { echo "no hypr socket: $SOCKET" >&2; exit 1; }

visible() {
  hyprctl monitors -j | jq -e --arg ws "special:$WORKSPACE" \
    '.[] | .specialWorkspace.name == $ws' >/dev/null
}

socat -U - "UNIX-CONNECT:$SOCKET" | while IFS= read -r line; do
  [[ $line == activewindow\>\>* ]] || continue
  class="${line#activewindow>>}"; class="${class%%,*}"
  [[ $class =~ $CLASS_RE ]] && continue
  visible && hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$WORKSPACE\")" >/dev/null
done
