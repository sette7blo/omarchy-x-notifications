# omaxbar config. Copied to config.sh on first install.
# Edit values and re-run install.sh to apply hypr-side changes.

# URL the hidden webapp loads.
URL="https://x.com/home"

# Hyprland special workspace name. Change if "xnotif" collides.
WORKSPACE="xnotif"

# Popover size in pixels. The window pins to the top-right; the x-offset
# install.sh writes is WIDTH + 12 to leave a 12 px gap from the screen edge.
WIDTH=440
HEIGHT=680
