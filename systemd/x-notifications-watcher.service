[Unit]
Description=Hide the X notifications popover when focus leaves it
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.config/omarchy/plugins/x-notifications/bin/x-notifications-watcher
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
